# Install CUDA-capable ML dependencies declared in pyproject.toml and locked in uv.lock.
FROM python:3.11-slim AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_LINK_MODE=copy
ARG UV_HTTP_TIMEOUT=300
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=bluff-sdk-gpu-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --locked --no-dev --no-install-project

FROM python:3.11-slim
ARG AGENT_CPU=1
ARG AGENT_RAM_BYTES=1073741824
ARG AGENT_SCRATCH_BYTES=1073741824
ARG AGENT_GPU_BYTES=1073741824
WORKDIR /app
LABEL org.triad-bluff.protocol="1.0" org.triad-bluff.runtime="2" \
      org.triad-bluff.cpu="${AGENT_CPU}" org.triad-bluff.ram-bytes="${AGENT_RAM_BYTES}" \
      org.triad-bluff.scratch-bytes="${AGENT_SCRATCH_BYTES}" \
      org.triad-bluff.gpu="true" org.triad-bluff.gpu-bytes="${AGENT_GPU_BYTES}"
COPY --from=dependencies /app/.venv ./.venv
COPY src/ ./src/
COPY models/ ./models/
COPY submission.json ./
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 HOME=/tmp
USER 10000:10000
ENTRYPOINT ["python", "src/agent.py"]
