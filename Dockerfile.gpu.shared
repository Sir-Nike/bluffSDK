# Official, publicly hosted PyTorch/CUDA runtime; no dependency install needed.
# Organizers may override this with another approved repository@sha256 digest.
ARG BLUFF_DEPENDENCY_BASE=pytorch/pytorch@sha256:c16f4c749e2d9e96878875cdf6cc45cddda1d1a36fddd371dd6f2360f1b6e2a2
FROM ${BLUFF_DEPENDENCY_BASE}
ARG AGENT_CPU=1
ARG AGENT_RAM_BYTES=1073741824
ARG AGENT_SCRATCH_BYTES=134217728
ARG AGENT_GPU_BYTES=1073741824
WORKDIR /app
LABEL org.triad-bluff.protocol="1.0" org.triad-bluff.runtime="2" \
      org.triad-bluff.cpu="${AGENT_CPU}" org.triad-bluff.ram-bytes="${AGENT_RAM_BYTES}" \
      org.triad-bluff.scratch-bytes="${AGENT_SCRATCH_BYTES}" \
      org.triad-bluff.gpu="true" org.triad-bluff.gpu-bytes="${AGENT_GPU_BYTES}"
COPY src/ ./src/
COPY models/ ./models/
COPY submission.json ./
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 HOME=/tmp
USER 10000:10000
ENTRYPOINT ["python", "src/agent.py"]
