FROM scratch AS ml_wheels
FROM python:3.11-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_LINK_MODE=copy
ARG UV_CONCURRENT_DOWNLOADS=1
ARG UV_HTTP_TIMEOUT=300
COPY cu128/pyproject.toml cu128/uv.lock ./
RUN --mount=type=bind,from=ml_wheels,target=/wheels \
    --mount=type=cache,id=triad-laptop-cu128-uv,target=/root/.cache/uv,sharing=locked \
    if [ -f /wheels/SHA256SUMS.json ]; then \
      uv export --locked --no-dev --no-emit-project --output-file /tmp/requirements.txt && \
      uv venv /app/.venv && \
      uv pip sync --python /app/.venv/bin/python --require-hashes --offline --no-index \
        --find-links=/wheels /tmp/requirements.txt; \
    else uv sync --locked --no-dev --no-install-project; fi

ARG AGENT_RAM_BYTES=1073741824
ARG AGENT_GPU_BYTES=1073741824
COPY src/ ./src/
COPY train.py ./
ENV PATH="/app/.venv/bin:$PATH"
RUN python train.py

FROM python:3.11-slim
WORKDIR /app
ARG AGENT_RAM_BYTES=1073741824
ARG AGENT_GPU_BYTES=1073741824
LABEL org.triad-bluff.protocol="1.0" org.triad-bluff.runtime="2" \
      org.triad-bluff.cpu="1" org.triad-bluff.ram-bytes="${AGENT_RAM_BYTES}" \
      org.triad-bluff.scratch-bytes="134217728" \
      org.triad-bluff.gpu="true" org.triad-bluff.gpu-bytes="${AGENT_GPU_BYTES}"
COPY --from=build /app/.venv ./.venv
COPY --from=build /app/src ./src
COPY --from=build /app/models ./models
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 HOME=/tmp
USER 10000:10000
ENTRYPOINT ["python", "src/agent.py"]
